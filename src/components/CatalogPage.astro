---
// Shared renderer for all product catalog pages (trees, shrubs, fruit trees, stone & mulch).
// Resolves each item's card photo from public/images/catalog/<category>/<slug>.(webp|jpg|jpeg|png)
// at build time and falls back to a leaf placeholder when no photo exists yet.
import fs from 'node:fs';
import path from 'node:path';
import type { CatalogCategory, CatalogItem } from '../data/catalog/types';
import { showPrices } from '../data/catalog/config';

interface Props {
  category: CatalogCategory;
}

const { category } = Astro.props;

const imageDir = path.resolve(`public/images/catalog/${category.id}`);
const extensions = ['.webp', '.jpg', '.jpeg', '.png'];

function resolveImage(item: CatalogItem): string | null {
  if (item.image) return item.image;
  for (const ext of extensions) {
    if (fs.existsSync(path.join(imageDir, item.slug + ext))) {
      return `/images/catalog/${category.id}/${item.slug}${ext}`;
    }
  }
  return null;
}

const gradeStyles: Record<string, string> = {
  regular: 'bg-gray-100 text-gray-600',
  deluxe: 'bg-[#2E7D4F]/10 text-[#2E7D4F]',
  premium: 'bg-[#8A6D1E]/10 text-[#8A6D1E]',
};

const deerStyles: Record<string, { label: string; classes: string }> = {
  resistant: { label: 'Deer Resistant', classes: 'bg-[#C3DAC9] text-[#3F6B4C]' },
  occasional: { label: 'Occasionally Browsed', classes: 'bg-[#FBF3DC] text-[#9C7C1E]' },
  frequent: { label: 'Frequently Browsed', classes: 'bg-[#FBE9E7] text-[#B54A3D]' },
};

const isPlantCatalog = category.sections.some((s) => s.items.some((i) => i.sun));
const multiSection = category.sections.length > 1;
---

<!-- Hero band -->
<section class="bg-gradient-to-b from-[#22311d] to-[#4a6741] pt-16 pb-14">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <span class="inline-block text-white/90 text-sm font-semibold uppercase tracking-wider bg-white/10 px-3 py-1 rounded-full mb-4">
      Greenscapes Catalog
    </span>
    <h1 class="text-4xl sm:text-5xl font-bold text-white">{category.title}</h1>
    <p class="text-white/70 mt-4 max-w-2xl mx-auto text-lg">{category.tagline}</p>

    {multiSection && (
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {category.sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="bg-white/10 hover:bg-white/20 text-white text-sm font-semibold px-5 py-2 rounded-full transition-colors"
          >
            {section.title}
          </a>
        ))}
      </div>
    )}
  </div>
</section>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
  {isPlantCatalog && (
    <div class="bg-[#EEF1EC] rounded-xl px-5 py-3.5 mb-12 flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 text-sm text-text-muted">
      <span>☀️ Sun needs</span>
      <span class="hidden sm:inline text-gray-400">|</span>
      <span>💧 Water needs</span>
      <span class="hidden sm:inline text-gray-400">|</span>
      <span>🌱 Deer resistance</span>
    </div>
  )}

  {category.sections.map((section, sectionIdx) => (
    <section id={section.id} class={sectionIdx > 0 ? 'mt-20 scroll-mt-24' : 'scroll-mt-24'}>
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-text">{section.title}</h2>
        {section.subtitle && <p class="text-text-muted mt-2">{section.subtitle}</p>}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {section.items.map((item) => {
          const img = resolveImage(item);
          return (
            <div class="bg-white border border-[#E3E6E0] rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow flex flex-col">
              {img ? (
                <img
                  src={img}
                  alt={item.name}
                  width="640"
                  height="480"
                  loading="lazy"
                  class="w-full h-52 object-cover"
                />
              ) : (
                <div class="w-full h-52 bg-gradient-to-br from-[#4a6741]/15 to-[#22311d]/10 flex items-center justify-center">
                  <svg class="w-12 h-12 text-[#4a6741]/40" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8m0 0c4.5 0 7.5-3 7.5-7.5V3.75h-1.75C13.25 3.75 10.25 6.75 10.25 11.25M12 13c0-3.5-2.5-6-6-6H4.5v1.5C4.5 12 7 14.5 10.5 14.5" />
                  </svg>
                </div>
              )}

              <div class="p-5 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-3">
                  <div>
                    <h3 class="font-bold text-text leading-snug">{item.name}</h3>
                    <p class="text-sm text-text-muted mt-0.5">{item.size}</p>
                  </div>
                  {item.grade && (
                    <span class={`shrink-0 text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-md ${gradeStyles[item.grade]}`}>
                      {item.grade}
                    </span>
                  )}
                </div>

                {item.description && (
                  <p class="text-sm text-text-muted mt-2.5">{item.description}</p>
                )}

                {(item.sun || item.water || item.deer) && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {item.sun && (
                      <span class="text-xs border border-[#E3E6E0] text-text-muted px-2 py-1 rounded-full">☀️ {item.sun}</span>
                    )}
                    {item.water && (
                      <span class="text-xs border border-[#E3E6E0] text-text-muted px-2 py-1 rounded-full">💧 {item.water}</span>
                    )}
                    {item.deer && (
                      <span class={`text-xs px-2 py-1 rounded-full ${deerStyles[item.deer].classes}`}>🌱 {deerStyles[item.deer].label}</span>
                    )}
                  </div>
                )}

                {item.matureSize && (
                  <p class="text-xs text-text-muted mt-3">Mature size: {item.matureSize}</p>
                )}

                <div class="mt-auto pt-4">
                  {showPrices && item.price ? (
                    <p class="text-lg font-bold text-[#1e7d1e]">${item.price} <span class="text-xs font-medium text-text-muted">est.</span></p>
                  ) : (
                    <a
                      href="/about#contact"
                      class="text-sm font-semibold text-[#4a6741] hover:text-[#1e7d1e] transition-colors"
                    >
                      Call for pricing →
                    </a>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  ))}
</div>

<!-- CTA band -->
<section class="bg-[#4a6741]">
  <div class="max-w-4xl mx-auto px-4 py-14 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-white">Ready to plant something new?</h2>
    <p class="text-white/70 mt-3 max-w-xl mx-auto">
      Every item in this catalog is delivered and professionally installed by our crew.
      Availability and pricing vary by season — reach out for a free estimate.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a
        href="/about#contact"
        class="bg-white text-[#4a6741] hover:bg-gray-100 px-7 py-3 rounded-lg font-semibold transition-colors"
      >
        Get a Free Estimate
      </a>
      <a
        href="tel:+18564725751"
        class="border border-white/40 text-white hover:bg-white/10 px-7 py-3 rounded-lg font-semibold transition-colors"
      >
        Call 856-472-5751
      </a>
    </div>
    <p class="text-white/40 text-xs mt-8">
      Representative photos; actual plants and materials may vary.
      <a href="/catalog/photo-credits" class="underline hover:text-white/70">Photo credits</a>
    </p>
  </div>
</section>
