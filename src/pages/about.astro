---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.vue';
import About from '../components/About.vue';
import ContactCTA from '../components/ContactCTA.vue';
import Footer from '../components/Footer.vue';
import { counties } from '../data/locations';
const jobberUrl = import.meta.env.JOBBER_URL || '';
---

<Layout
  title="About Us — Greenscapes Landscaping & Construction"
  description="Greenscapes — a Sicklerville, NJ property maintenance company offering expert landscaping, hardscaping, and outdoor construction across South Jersey."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About Us', url: '/about' },
  ]}
>
  <Navbar client:load />
  <main class="pt-16">
    <About />

    <!-- Socials Bar -->
    <section class="bg-[#4a6741] py-16">
      <div class="max-w-5xl mx-auto px-4 flex flex-wrap items-center justify-center gap-12 sm:gap-20">
        <a href="tel:+18564725751" class="flex items-center gap-4 text-white hover:text-emerald-200 transition-colors">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span class="text-xl font-medium">856-472-5751</span>
        </a>
        <a href="https://www.instagram.com/greenscapesconstruction/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-white hover:text-emerald-200 transition-colors">
          <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          <span class="text-xl font-medium">Instagram</span>
        </a>
        <a href="https://www.facebook.com/105938601687540" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-white hover:text-emerald-200 transition-colors">
          <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span class="text-xl font-medium">Facebook</span>
        </a>
        <a href="https://www.tiktok.com/@greenscapesconstruction" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-white hover:text-emerald-200 transition-colors">
          <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13a8.28 8.28 0 005.58 2.17v-3.45a4.85 4.85 0 01-3.77-1.26V6.69h3.77z"/>
          </svg>
          <span class="text-xl font-medium">TikTok</span>
        </a>
      </div>
    </section>

    <!-- Locations / Service Area -->
    <section id="locations" class="py-20 bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block text-white text-sm font-semibold uppercase tracking-wider bg-[#4a6741] px-3 py-1 rounded-full mb-4">Service Area</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-text mt-2">Areas We Serve</h2>
          <p class="text-text-muted mt-4 max-w-2xl mx-auto">Proudly serving South Jersey communities from our home base in Sicklerville, NJ.</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Map image (replace src with your static image) -->
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <img src="/images/service-area-map.webp" alt="Greenscapes Landscaping & Construction Service Area Map" width="1024" height="1024" class="w-full h-auto" loading="lazy" />
          </div>

          <!-- County list -->
          <div>
            <h3 class="text-2xl font-bold text-text mb-6">Counties We Service</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {counties.map((county) => (
                <li class="flex items-center gap-3">
                  <div class="w-6 h-6 bg-[#4a6741]/20 rounded-full flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5 text-[#4a6741]" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </div>
                  <span class="text-text font-medium">{county}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA client:load jobberUrl={jobberUrl} />
  </main>
  <Footer />
</Layout>
