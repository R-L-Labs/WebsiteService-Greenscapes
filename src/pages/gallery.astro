---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.vue';
import Footer from '../components/Footer.vue';
import fs from 'node:fs';
import path from 'node:path';

const galleryDir = path.resolve('public/images/gallery');
const extensions = new Set(['.jpg', '.jpeg', '.png', '.webp']);
// Non-project marketing/branding assets that live in gallery folders but
// shouldn't appear in the public portfolio.
const excludedFiles = new Set(['greenscapes-yard-sign-south-jersey.png']);

const images: string[] = [];

for (const cat of ['landscaping', 'hardscaping', 'construction']) {
  const dir = path.join(galleryDir, cat);
  if (!fs.existsSync(dir)) continue;
  const files = fs.readdirSync(dir).filter(f =>
    extensions.has(path.extname(f).toLowerCase()) && !excludedFiles.has(f)
  );
  for (const file of files) {
    images.push(`/images/gallery/${cat}/${file}`);
  }
}
---

<Layout
  title="Gallery — Greenscapes Landscaping & Construction"
  description="Browse our portfolio of landscaping, hardscaping, and construction projects completed by Greenscapes Landscaping & Construction."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Gallery', url: '/gallery' },
  ]}
>
  <Navbar client:load />
  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <span class="text-[#1e7d1e] text-sm font-semibold uppercase tracking-wider">Our Portfolio</span>
        <h1 class="text-4xl sm:text-5xl font-bold text-text mt-3">Project Gallery</h1>
        <p class="text-text-muted mt-4 max-w-2xl mx-auto text-lg">
          Browse through our completed landscaping, hardscaping, and construction projects across South Jersey.
        </p>
      </div>

      {images.length > 0 ? (
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
          {images.map((src) => (
            <div class="break-inside-avoid group rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all cursor-pointer gallery-item">
              <img
                src={src}
                alt="Project photo"
                class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-text-muted text-lg mb-6">Gallery images coming soon!</p>
          <a
            href="https://www.instagram.com/greenscapesconstruction/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-[#4a6741] hover:bg-[#5a7a51] text-white px-6 py-3 rounded-lg font-semibold transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            Follow us on Instagram
          </a>
        </div>
      )}

      <!-- Lightbox -->
      <div id="lightbox" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center cursor-pointer" onclick="this.classList.add('hidden'); this.classList.remove('flex');">
        <button class="absolute top-4 right-4 text-white/70 hover:text-white text-4xl">&times;</button>
        <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain rounded-lg shadow-2xl" />
      </div>
    </div>
  </main>
  <Footer />

  <script>
    document.querySelectorAll('.gallery-item img').forEach(img => {
      img.addEventListener('click', () => {
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
        lightboxImg.src = (img as HTMLImageElement).src;
        lightbox?.classList.remove('hidden');
        lightbox?.classList.add('flex');
      });
    });
  </script>
</Layout>
