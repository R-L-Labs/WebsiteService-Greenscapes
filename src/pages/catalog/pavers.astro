---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.vue';
import CatalogPageB from '../../components/CatalogPageB.astro';
import Footer from '../../components/Footer.vue';
import { pavers } from '../../data/catalog';

const allItems = pavers.sections.flatMap((s) => s.items);
---

<Layout
  title="Pavers, Bricks & Stone Catalog — Greenscapes Landscaping & Construction"
  description="Browse Cambridge and Belgard pavers, wall and step systems, PA bluestone, stepping stones, and porch brick — professionally installed across South Jersey."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Catalog', url: '/catalog' },
    { name: 'Pavers & Brick', url: '/catalog/pavers' },
  ]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Greenscapes Pavers, Bricks & Stone Catalog',
    numberOfItems: allItems.length,
    itemListElement: allItems.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: item.name,
    })),
  })} />
  <Navbar client:load />
  <main class="pt-16">
    <CatalogPageB category={pavers} />
  </main>
  <Footer />
</Layout>
