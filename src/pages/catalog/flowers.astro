---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.vue';
import CatalogPage from '../../components/CatalogPage.astro';
import Footer from '../../components/Footer.vue';
import { flowers } from '../../data/catalog';

const allItems = flowers.sections.flatMap((s) => s.items);
---

<Layout
  title="Flower Catalog — Greenscapes Landscaping & Construction"
  description="Browse annuals and perennials available for professional planting in South Jersey — petunias, zinnias, coneflowers, astilbe, and more for beds, pots, and baskets."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Catalog', url: '/catalog' },
    { name: 'Flowers', url: '/catalog/flowers' },
  ]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Greenscapes Flower Catalog',
    numberOfItems: allItems.length,
    itemListElement: allItems.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: item.name,
    })),
  })} />
  <Navbar client:load />
  <main class="pt-16">
    <CatalogPage category={flowers} />
  </main>
  <Footer />
</Layout>
