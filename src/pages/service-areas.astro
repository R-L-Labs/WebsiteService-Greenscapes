---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.vue';
import ContactCTA from '../components/ContactCTA.vue';
import Footer from '../components/Footer.vue';
import { serviceAreas, priorityTowns } from '../data/locations';

const jobberUrl = import.meta.env.JOBBER_URL || '';
const totalTowns = Object.values(serviceAreas).reduce((sum, t) => sum + t.length, 0);
const countyCount = Object.keys(serviceAreas).length;
---

<Layout
  title="Service Areas — Greenscapes Landscaping & Construction"
  description={`Greenscapes serves ${totalTowns}+ towns across ${countyCount} South Jersey counties — landscaping, hardscaping, roofing, siding, windows, gutters, and snow removal in Camden, Gloucester, Burlington, Atlantic, and Ocean counties.`}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Service Areas', url: '/service-areas' },
  ]}
>
  <Navbar client:load />
  <main class="pt-24 pb-20">
    <!-- Hero -->
    <section class="bg-surface border-b border-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <span class="inline-block text-white text-sm font-semibold uppercase tracking-wider bg-[#4a6741] px-3 py-1 rounded-full mb-4">Where We Work</span>
        <h1 class="text-4xl sm:text-5xl font-bold text-text mt-2">South Jersey Service Areas</h1>
        <p class="text-text-muted mt-4 max-w-3xl mx-auto text-lg leading-relaxed">
          Greenscapes Landscaping &amp; Construction serves {totalTowns}+ towns across {countyCount} South Jersey counties.
          From routine lawn care and mulch installation to roofing, siding, and commercial snow removal —
          we work where you live and where your business operates.
        </p>

        <!-- Priority towns chips -->
        <div class="mt-8 flex flex-wrap justify-center gap-2 max-w-4xl mx-auto">
          {priorityTowns.map((town) => (
            <span class="inline-flex items-center text-sm font-medium text-[#4a6741] bg-[#4a6741]/10 px-3 py-1.5 rounded-full">
              {town}
            </span>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="/about#contact"
            class="bg-[#4a6741] hover:bg-[#5a7a51] text-white px-6 py-3 rounded-lg text-base font-semibold transition-colors shadow-md"
          >
            Get a Free Estimate
          </a>
          <a
            href="tel:+18564725751"
            class="border border-[#4a6741] text-[#4a6741] hover:bg-[#4a6741] hover:text-white px-6 py-3 rounded-lg text-base font-semibold transition-colors"
          >
            Call 856-472-5751
          </a>
        </div>
      </div>
    </section>

    <!-- Map + intro -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
          <div class="lg:col-span-2 rounded-2xl overflow-hidden shadow-xl">
            <img
              src="/images/service-area-map.webp"
              alt="Map of Greenscapes Landscaping & Construction service area across South Jersey"
              width="1024"
              height="1024"
              loading="lazy"
              class="w-full h-auto"
            />
          </div>
          <div class="lg:col-span-3">
            <h2 class="text-3xl sm:text-4xl font-bold text-text mb-4">Full-Service Exterior Contractor for South Jersey</h2>
            <p class="text-text-muted text-lg leading-relaxed mb-4">
              Based in Sicklerville, NJ, our crews travel across Camden, Gloucester, Burlington, Atlantic, Cape May, Ocean,
              Salem, and Cumberland counties for residential and commercial projects.
            </p>
            <p class="text-text-muted text-lg leading-relaxed mb-4">
              <strong>Landscaping &amp; lawn care</strong> — mulch installation, spring and fall cleanup, planting,
              weekly mowing, and full landscape design.
              <strong>Hardscaping</strong> — paver patios, flagstone walkways, retaining walls, fire pits, and outdoor
              living areas.
              <strong>Exterior construction</strong> — roof replacement and repair, siding, replacement windows, seamless
              gutters, soffit and fascia, and storm damage repair.
              <strong>Commercial property maintenance</strong> — HOAs, office parks, retail centers, restaurants, banks,
              and rental property portfolios.
              <strong>Commercial snow removal</strong> — parking lot plowing, salting, and sidewalk deicing under per-push
              or seasonal contracts.
            </p>
            <p class="text-text-muted text-lg leading-relaxed">
              Don't see your town listed? Call us anyway — if you're within reasonable driving distance of one of the
              counties below, we can usually still help.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Counties + towns -->
    <section class="py-16 bg-surface">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-[#1e7d1e] text-sm font-semibold uppercase tracking-wider">By County</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-text mt-2">Towns We Serve</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {Object.entries(serviceAreas).map(([county, towns]) => (
            <div class="bg-white border border-border rounded-xl p-6 shadow-sm">
              <h3 class="text-xl font-bold text-text mb-1">{county}</h3>
              <p class="text-sm text-text-muted mb-4">{towns.length} towns served</p>
              <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
                {towns.map((town) => (
                  <li class="flex items-center gap-2 text-text">
                    <span class="w-1.5 h-1.5 bg-[#4a6741] rounded-full shrink-0"></span>
                    <span class="text-sm">{town}, NJ</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ContactCTA client:load jobberUrl={jobberUrl} bgColorFrom="#4a6741" bgColorTo="#22311d" />
  </main>
  <Footer />
</Layout>
