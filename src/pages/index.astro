---
import Layout from '../layouts/Layout.astro';
import HomePanel from '../components/HomePanel.vue';
---

<Layout title="Greenscapes - Landscaping, Hardscaping & Construction" description="Greenscapes Landscaping & Construction is a property maintenance company based out of Sicklerville, NJ providing expert landscaping services to residential and commercial clients.">
  <div class="min-h-screen flex flex-col items-center justify-center p-4 sm:p-6 md:p-8 bg-white">
    <!-- Header: logo + tagline + contact -->
    <div class="flex items-center justify-between mb-4 md:mt-[-4rem] w-full max-w-[120rem] px-4 sm:px-8">
      <div class="flex items-center gap-4">
        <img src="/images/logo.png" alt="Greenscapes Landscaping & Construction" class="h-16 sm:h-20 object-contain" />
        <div class="flex flex-col leading-tight">
          <span class="text-xl sm:text-2xl font-bold text-gray-900">Greenscapes</span>
          <span class="text-sm sm:text-base font-medium text-gray-500">Landscaping & Construction</span>
          <span class="mt-1 inline-flex items-center gap-1.5 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-[#4a6741]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#4a6741]"></span>
            Commercial &amp; Residential
          </span>
        </div>
      </div>
      <!-- About dropdown (center) -->
      <div class="hidden sm:block relative" id="about-dropdown">
        <button onclick="document.getElementById('about-menu').classList.toggle('hidden')"
          class="flex items-center gap-1 text-gray-700 hover:text-[#4a6741] font-semibold text-base transition-colors">
          About
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="about-menu" class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 w-44 bg-white border border-gray-200 rounded-lg shadow-lg py-1 z-50">
          <a href="/about" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-[#4a6741] transition-colors">About Us</a>
          <a href="/gallery" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-[#4a6741] transition-colors">Gallery</a>
        </div>
      </div>

      <div class="hidden sm:flex flex-col items-center gap-1 self-center">
        <a href="/about#contact"
          class="bg-[#4a6741] hover:bg-[#5a7a51] text-white px-8 py-2.5 rounded-lg text-base font-semibold transition-colors shadow-md">
          Free Estimate
        </a>
        <a href="tel:+18564725751" class="flex items-center gap-2 text-gray-500 hover:text-[#4a6741] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <span class="text-sm font-medium">856-472-5751</span>
        </a>
        <a href="mailto:greenscapessj@gmail.com" class="flex items-center gap-2 text-gray-500 hover:text-[#4a6741] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          <span class="text-sm font-medium">greenscapessj@gmail.com</span>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="w-full max-w-[120rem] border-t border-gray-200 mb-4"></div>

    <div class="relative w-full max-w-[120rem]">
      <!-- 3 panels: side-by-side on desktop, stacked on mobile -->
      <div class="flex flex-col md:flex-row w-full gap-3 md:gap-4">
        <HomePanel
          client:load
          title="Landscaping"
          description="Expert landscaping services for residential and commercial clients. From custom garden designs to complete landscape transformations."
          href="/landscaping"
          gradient="from-emerald-950 via-emerald-900 to-green-950"
          image="/images/gallery/landscaping/landscape_7_2.JPG"
        />
        <HomePanel
          client:load
          title="Hardscaping"
          description="Patio construction, retaining walls, walkways, and outdoor living areas crafted with premium materials and precision workmanship."
          href="/hardscaping"
          gradient="from-stone-900 via-stone-800 to-zinc-900"
          image="/images/hardscaping.jpg"
          buttonColor="#5b9bd5"
          buttonHoverColor="#7bb0e0"
        />
        <HomePanel
          client:load
          title="Construction"
          description="Outdoor construction including roofing, siding, gutters, windows, and gazebos built to code and built to last."
          href="/construction"
          gradient="from-amber-950 via-amber-900 to-yellow-950"
          image="/images/construction.jpg"
          buttonColor="#8B5E3C"
          buttonHoverColor="#A0724F"
        />
      </div>
    </div>
  </div>
  <script>
    document.addEventListener('click', (e) => {
      const dropdown = document.getElementById('about-dropdown');
      const menu = document.getElementById('about-menu');
      if (dropdown && menu && !dropdown.contains(e.target as Node)) {
        menu.classList.add('hidden');
      }
    });
  </script>
</Layout>
