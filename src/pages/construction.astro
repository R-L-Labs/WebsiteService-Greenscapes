---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.vue';
import Hero from '../components/Hero.vue';
import Services from '../components/Services.vue';
import Projects from '../components/Projects.vue';
import InstagramGallery from '../components/InstagramGallery.astro';
import Testimonials from '../components/Testimonials.vue';
import ContactCTA from '../components/ContactCTA.vue';
import Footer from '../components/Footer.vue';

import * as data from '../data/construction';
import { getSocialProjects, getSocialTestimonials } from '../lib/social';

const jobberUrl = import.meta.env.JOBBER_URL || '';
const lightwidgetUrl = import.meta.env.LIGHTWIDGET_URL || '';
const instagramProjects = await getSocialProjects(6);
const facebookTestimonials = await getSocialTestimonials(3);
const projectItems = instagramProjects?.length ? instagramProjects : data.projects.items;
const testimonialItems = facebookTestimonials?.length ? facebookTestimonials : data.testimonials.items;

// Construction colors — 3 shades of brown/tan
const bright = '#a07040';
const mid = '#7a6041';
const dark = '#31261d';
---

<Layout
  title="Construction Services — Greenscapes Landscaping & Construction"
  description="Professional outdoor construction services in Sicklerville, NJ including pergolas, decks, fencing, drainage solutions, gazebos, and site grading."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Construction', url: '/construction' },
  ]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Construction Services",
    "description": "Professional outdoor construction services including pergolas, decks, fencing, drainage solutions, gazebos, and site grading.",
    "provider": { "@id": "https://greenscapessj.com/#business" },
    "url": "https://greenscapessj.com/construction",
    "areaServed": { "@type": "Place", "name": "South Jersey, NJ" },
    "serviceType": "Outdoor Construction"
  })} />
  <Navbar client:load />
  <main class="pt-16" style={`--color-primary: ${bright}; --color-primary-light: ${mid}; --color-primary-dark: ${dark};`}>
    <Hero
      badge={data.hero.badge}
      title={data.hero.title}
      titleAccent={data.hero.titleAccent}
      description={data.hero.description}
      ctaPrimary={data.hero.ctaPrimary}
      ctaSecondary={data.hero.ctaSecondary}
      stats={data.hero.stats}
      backgroundImage="/images/construction.jpg"
      accentColor={bright}
    />
    <Services
      subtitle={data.services.subtitle}
      title={data.services.title}
      description={data.services.description}
      items={data.services.items}
      accentColor={bright}
    />
    <Testimonials
      subtitle={data.testimonials.subtitle}
      title={data.testimonials.title}
      description={data.testimonials.description}
      items={testimonialItems}
      bgColor={dark}
      accentColor={bright}
    />
    {lightwidgetUrl ? (
      <InstagramGallery widgetUrl={lightwidgetUrl} accentColor={bright} />
    ) : (
      <Projects
        subtitle={data.projects.subtitle}
        title={data.projects.title}
        description={data.projects.description}
        items={projectItems}
      />
    )}
    <ContactCTA client:load jobberUrl={jobberUrl} bgColorFrom={mid} bgColorTo={dark} />
  </main>
  <Footer />
</Layout>
