---
import '../styles/global.css';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title = 'Greenscapes — Landscaping, Hardscaping & Construction',
  description = 'Greenscapes — South Jersey landscaping, hardscaping, and outdoor construction for residential and commercial clients. Free estimates in Sicklerville, NJ.',
  // Falls back to the square logo until a proper 1200×630 social card is added
  // at public/og-default.jpg. Swap this default to '/og-default.jpg' once added.
  image = '/images/logo.png',
  type = 'website',
  breadcrumbs,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;

const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: crumb.name,
        item: new URL(crumb.url, Astro.site).href,
      })),
    }
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:site_name" content="Greenscapes Landscaping & Construction" />
    <meta property="og:locale" content="en_US" />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1e7d1e" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Page-specific head content -->
    <slot name="head" />

    <!-- LocalBusiness Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://greenscapessj.com/#business",
      "name": "Greenscapes Landscaping & Construction",
      "description": "Property maintenance company providing expert landscaping, hardscaping, and construction services to residential and commercial clients in South Jersey.",
      "url": "https://greenscapessj.com",
      "telephone": "+1-856-472-5751",
      "email": "greenscapessj@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sicklerville",
        "addressRegion": "NJ",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.7168,
        "longitude": -74.9688
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 39.7168,
          "longitude": -74.9688
        },
        "geoRadius": "50000"
      },
      "image": "https://greenscapessj.com/images/logo.png",
      "logo": "https://greenscapessj.com/images/logo.png",
      "sameAs": [
        "https://www.instagram.com/greenscapesconstruction/",
        "https://www.facebook.com/105938601687540",
        "https://www.tiktok.com/@greenscapesconstruction"
      ],
      "priceRange": "$$",
      "serviceType": ["Landscaping", "Hardscaping", "Outdoor Construction"]
    })} />

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
