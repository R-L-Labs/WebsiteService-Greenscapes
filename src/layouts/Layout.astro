---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Greenscapes - Landscaping, Hardscaping & Construction',
  description = 'Greenscapes - Landscaping & Construction is a property maintenance company based out of Sicklerville, NJ providing expert landscaping services to residential and commercial clients.',
  image = '/images/logo.png',
  type = 'website',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:site_name" content="Greenscapes Landscaping & Construction" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1e7d1e" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Page-specific head content -->
    <slot name="head" />

    <!-- LocalBusiness Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "https://greenscapessj.com/#business",
      "name": "Greenscapes Landscaping & Construction",
      "description": "Property maintenance company providing expert landscaping, hardscaping, and construction services to residential and commercial clients in South Jersey.",
      "url": "https://greenscapessj.com",
      "telephone": "+1-856-472-5751",
      "email": "greenscapessj@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Sicklerville",
        "addressRegion": "NJ",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.7168,
        "longitude": -74.9688
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": 39.7168,
          "longitude": -74.9688
        },
        "geoRadius": "50000"
      },
      "image": "https://greenscapessj.com/images/logo.png",
      "logo": "https://greenscapessj.com/images/logo.png",
      "sameAs": [
        "https://www.instagram.com/greenscapessj/",
        "https://www.facebook.com/greenscapessj/"
      ],
      "priceRange": "$$",
      "serviceType": ["Landscaping", "Hardscaping", "Outdoor Construction"]
    })} />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
