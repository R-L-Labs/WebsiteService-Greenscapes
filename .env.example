# Jobber Online Booking
# When set, "Free Estimate" buttons link to this URL instead of the contact form
JOBBER_URL=

# LightWidget Instagram Gallery
# Create a widget at https://lightwidget.com and paste the iframe URL here
# Example: //lightwidget.com/widgets/abc123def456.html
LIGHTWIDGET_URL=

# Instagram Graph API (for Featured Projects)
# Get these from Meta Developer Portal: https://developers.facebook.com/
# Requires a Business/Creator Instagram account connected to a Facebook Page
# Long-lived tokens last ~60 days — refresh before expiry
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=